DJANGO_SECRET_KEY=replace-with-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,your-vm-domain
CORS_ALLOWED_ORIGINS=http://localhost:8080
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=smartcity
POSTGRES_USER=smartcity_dashboard
POSTGRES_PASSWORD=replace
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=smartcity/nodes/+/measurements
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BIND_IP=127.0.0.1
WEB_PORT=8080
WEB_BIND_IP=0.0.0.0
MODEL_ENABLED=true
FORECAST_INTERVAL_SECONDS=300
